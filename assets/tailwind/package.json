{
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-truncate-multiline": "^1.0.3"
  },
  "scripts": {
    "serve": "cross-env NODE_ENV=development concurrently \"postcss style/style.css -o dist/style/style.css --watch\"",
    "development": "cross-env NODE_ENV=development postcss style/style.css -o dist/style/style.css",
    "production": "cross-env NODE_ENV=production postcss style/style.css -o ../../style/tailwind/style.css"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.9",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.1"
}
