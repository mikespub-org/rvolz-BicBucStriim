{
    "scripts": {
        "css-dev": [
            "yarn --cwd assets/tailwind run development"
        ],
        "css-watch": [
            "yarn --cwd assets/tailwind run serve"
        ],
        "css-prod": [
            "yarn --cwd assets/tailwind run production"
        ],
        "dev-up": [
            "docker compose -f docker-compose-dev.yaml up -d"
        ],
        "dev-down": [
            "docker compose -f docker-compose-dev.yaml down"
        ]
    }
}
