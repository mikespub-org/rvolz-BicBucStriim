<html lang="{{ page.glob.lang|default('en') }}" {% if page.custom == 'darksoha' %}data-theme="darksoha"{% endif %}>
<head>
    <meta charset="utf-8">
    <title>{{ page.title }}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {% block headerlinks %}{% endblock %}
    {% if page.custom and page.custom != '' %}
    <link rel="stylesheet" href="{{page.rot}}/style/{{page.custom}}/style.css">
    {% else %}
    <link rel="stylesheet" href="{{page.rot}}/style/style.css">
    {% endif %}
    <link rel="icon" href="{{page.rot}}/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="{{page.rot}}/bbs-icon.png">
    <script src="{{page.rot}}/js/script.js" defer></script>
</head>
<body class="bbs-body {% if page.custom == 'darksoha' %}darksoha{% endif %}">
{% include "icons.twig" %}

<div data-role="page" data-title="{{ page.title }}" {% block pid %}{% endblock %}>

    <header class="bbs-header" data-role="header">
        <div class="bbs-header-bar">
            <p class="bbs-header-title">
                {{ page.title }}
            </p>

            <div class="bbs-header-actions">
                {% if page.level == 1 and page.menu == 1 %}
                <a id="show_home_options" href="#home_options_panel" class="bbs-header-btn" title="{{ page.glob.l10n.pagination_search }}">
                    <svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-search" href="#bbs-icon-search"/></svg>
                </a>
                {% endif %}
                {% if page.level == 1 and page.menu == 2 %}
                <a id="show_titles_options" href="#titles_options_panel" class="bbs-header-btn" title="{{ page.glob.l10n.pagination_search }}">
                    <svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-search" href="#bbs-icon-search"/></svg>
                </a>
                {% endif %}
                {% if page.level == 1 and page.menu == 3 %}
                <a id="show_authors_options" href="#authors_options_panel" class="bbs-header-btn" title="{{ page.glob.l10n.pagination_search }}">
                    <svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-search" href="#bbs-icon-search"/></svg>
                </a>
                {% endif %}
                {% if page.level == 1 and page.menu == 4 %}
                <a id="show_tags_options" href="#tags_options_panel" class="bbs-header-btn" title="{{ page.glob.l10n.pagination_search }}">
                    <svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-search" href="#bbs-icon-search"/></svg>
                </a>
                {% endif %}
                {% if page.level == 1 and page.menu == 5 %}
                <a id="show_series_options" href="#series_options_panel" class="bbs-header-btn" title="{{ page.glob.l10n.pagination_search }}">
                    <svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-search" href="#bbs-icon-search"/></svg>
                </a>
                {% endif %}
                {% if page.admin %}
                <a href="{{page.rot}}/admin/" class="bbs-header-btn" title="{{ page.glob.l10n.admin_short }}">
                    <svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-gear" href="#bbs-icon-gear"/></svg>
                </a>
                {% endif %}
                {% if page.auth %}
                <a class="bbs-header-btn" href="{{page.rot}}/logout/" title="{{ page.glob.l10n.logout }}">
                    <svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-power" href="#bbs-icon-power"/></svg>
                </a>
                {% endif %}
            </div>
        </div>

        {% if page.dialog==false %}
        {% include "navbar.twig" %}
        {% endif %}
    </header>

    <main class="bbs-content" data-role="content">
        {% block content %}{% endblock %}
    </main>

    <footer class="bbs-footer footer" data-role="footer">
        {% include "footer.twig" %}
    </footer>

    {% block leftpanel %}{% endblock %}
    {% block rightpanel %}{% endblock %}
</div>
<!-- page -->

</body>
</html>
