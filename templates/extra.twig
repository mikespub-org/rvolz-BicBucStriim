{% extends 'main.twig' %}

{% block pid %}id="pextra"{%endblock%}

{% block headerlinks %}{% endblock %}

{% block content %}
	{% include "flash_messages.twig" %}
	<ul class="bbs-listview" data-role="listview">
		{% for option in options %}
			<li class="bbs-list-item">
				<a class="bbs-list-link" {% if option.external %}rel="external" target="_blank"{% endif %} href="{{page.rot}}/extra/{{option.id}}/">
					<div class="bbs-list-info">
						<h3 class="bbs-list-title">{{ option.label }}</h3>
						<p class="bbs-list-meta">{{ option.description }}</p>
					</div>
					<svg class="bbs-icon bbs-list-arrow" aria-hidden="true"><use xlink:href="#bbs-icon-carat-r" href="#bbs-icon-carat-r"/></svg>
				</a>
			</li>
		{% endfor %}
	</ul>
{% endblock %}
