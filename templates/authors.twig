<link rel="related" href="{{page.rot}}/opds/"
  	type="application/atom+xml;profile=opds-catalog" title="OPDS index">
  <link rel="alternate" href="{{page.rot}}/opds/authorlist/" 
  	type="application/atom+xml;profile=opds-catalog" title="OPDS catalog: by authors">
{% endblock %}

{% block pid %}id="pauthors"{%endblock%}

{% block content %}
<ul class="bbs-listview" data-role="listview" data-filter="false">	
	{% for author in authors %}
		{% if author.initial != "" %}
			<li class="bbs-list-divider" data-role="list-divider">{{ author.initial }}</li>
		{% else %}
			<li class="bbs-list-item">
				<a class="bbs-list-link" href="{{page.rot}}/authors/{{ author.id }}/0/">
					{% if author.thumbnail %}
					<img class="bbs-avatar" src="{{page.rot}}/{{author.thumbnail.url}}" alt="" />
					{% else %}
					<img class="bbs-avatar" src="{{page.rot}}/img/writer.png" alt="" />
					{% endif %}
					<div class="bbs-list-info">
						<h3 class="bbs-list-title">{{ author.name }}</h3>
					</div>
					<span class="bbs-badge ui-li-count">{{author.anzahl}}</span>
					<svg class="bbs-icon bbs-list-arrow" aria-hidden="true"><use xlink:href="#bbs-icon-carat-r" href="#bbs-icon-carat-r"/></svg>
				</a>
			</li>
		{% endif %}
	{% endfor %}
</ul>
{% endblock %}

{% block leftpanel %}
<section class="bbs-panel" data-role="panel" data-display="overlay" data-position="left" id="authors_options_panel">
    <h2>{{page.glob.l10n.pagination_search}}</h2>

    {% include 'search.part.twig' %}
</section>
{% endblock %}
