{% extends 'main.twig' %}

{% block pid %}id="pauthor_notes"{%endblock%}

{% block content %}
{% include "flash_messages.twig" %}
<section id="author-mdnotes-panel">
	<header>
		<h2>{{page.glob.l10n.author_notes}}</h2>
	</header>
	<p class="bbs-form-help">{{page.glob.l10n.author_notes_expl}}</p>
	<div id="editor"></div>
	<form id="author-note-edit" action="{{page.rot}}/metadata/authors/{{ author.id }}/notes/">
  		<textarea name="note-edit" id="note-edit" rows="8" style="width:100%;">{{author.notes_source}}</textarea>
  		<div class="bbs-btn-group">
  			<input type="submit" class="bbs-btn bbs-btn-primary" value="{{page.glob.l10n.save}}" />
			<a class="bbs-btn bbs-btn-danger" id="delete-notes" href="#" data-proot="{{page.rot}}" data-author="{{ author.id }}">
				{{page.glob.l10n.delete}}
			</a>
  		</div>
	</form>
</section>
<section id="author-notes" style="margin-top: 20px;">
	{{author.notes|raw}}
</section>
{% endblock %}
