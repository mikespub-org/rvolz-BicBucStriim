{% extends 'main.twig' %}

{% block pid %}id="pseries_detail"{%endblock%}

{% block content %}
<section class="series_detail">
	<header class="clearfix">
		{# Display available metadata only on first page #}
		{% if curpage == 0 %}
			<div id="series-metadata" class="author-metadata-grid">
				<div class="author-thumb-col">
					<h2>{{page.glob.l10n.booksbyseries}} <em>{{ series.name }}</em></h2>
					{% if series.thumbnail %}
					<img id="series-thumbnail-pic" src="{{page.rot}}/{{series.thumbnail.url}}" alt="{{ series.name }}" />
					{% endif %}
				</div>
				<div id="series-links" class="author-info-col">
					<ul id="series-links-list" class="bbs-btn-group" style="list-style:none; padding:0; margin:0 0 10px 0;">
					{% if series.link %}
						<li class="series-link link-0">
							<a class="bbs-btn bbs-btn-mini" rel="external" target="_blank" href="{{series.link}}">
								<svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-cloud" href="#bbs-icon-cloud"/></svg>
								<span>{{page.glob.l10n.calibre_link}}</span>
							</a>
						</li>
					{% endif %}
					</ul>
					{% if series.note %}
					<details class="bbs-collapsible" id="note" data-role="collapsible" open>
						<summary class="bbs-collapsible-header">{{page.glob.l10n.calibre_notes}}</summary>
						<div class="bbs-collapsible-content">
							<section id="series-note">
								{{series.note|raw}}
							</section>
						</div>
					</details>
					{% endif %}
				</div>
			</div>
		{% else %}
			<h2>
				{{page.glob.l10n.booksbyseries}} <em>{{ series.name }}</em>
			</h2> 
		{% endif %}
	</header>
	
	<section id="series-books" style="margin-top: 15px;">
		<ul class="bbs-listview" data-role="listview">
			{% for book in books %}
				{% include "title_entry.twig" %}
			{% endfor %}	
		</ul>
	</section>
</section>

{% endblock %}
