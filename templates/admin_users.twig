{% extends 'main.twig' %}

{% block pid %}id="padmin_users" data-ajax="true"{%endblock%}
{% block content %}

<header>
	<h1>{{ page.glob.l10n.admin_users }}</h1>
</header>
{% include "flash_messages.twig" %}

<h2>{{page.glob.l10n.admin_users_legend1}}</h2>
<form action="{{page.rot}}/admin/users/" method="post" id="newuserform" data-proot="{{page.rot}}" style="max-width: 600px; margin-bottom: 25px;">
	<fieldset data-role="fieldcontain">
		<label for="newuser_name">{{page.glob.l10n.admin_username}}</label>
		<input name="newuser_name" id="newuser_name" type="text" 
			value="" placeholder="{{page.glob.l10n.admin_username}}" required />
	</fieldset>	
	<fieldset data-role="fieldcontain">
		<label for="newuser_password">{{page.glob.l10n.admin_userpw}}</label>
		<input name="newuser_password" id="newuser_password" type="password" 
			value="" placeholder="{{page.glob.l10n.admin_userpw}}" required />
	</fieldset>	
	<button type="submit" class="bbs-btn bbs-btn-primary bbs-btn-block">
		<svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-check" href="#bbs-icon-check"/></svg>
		<span>{{page.glob.l10n.save}}</span>
	</button>	
</form>

<h2>{{page.glob.l10n.admin_users_legend2}}</h2>
<ul id="users" class="bbs-listview" data-role="listview" style="max-width: 600px;">
{% for user in users %}
	<li class="bbs-list-item" data-user="{{user.id}}" style="padding: 10px 15px; display: flex; justify-content: space-between; align-items: center;">
		<a href="{{page.rot}}/admin/users/{{user.id}}/" style="font-weight: 600; font-size: 1.05rem;">
			{{user.username}}
		</a>
		<a class="bbs-btn bbs-btn-danger bbs-btn-mini user_delete" href="#" data-user="{{user.id}}">
			{{page.glob.l10n.admin_users_delete}}
		</a>
	</li>
{% endfor %}
</ul>

<div id="delete" class="bbs-modal" data-role="popup">
	<h3>{{page.glob.l10n.admin_users_delete}}?</h3>
	<div class="bbs-btn-group" style="margin-top: 15px;">
		<a id="delete_user" class="bbs-btn bbs-btn-danger" data-proot="{{page.rot}}" href="#">
			<svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-check" href="#bbs-icon-check"/></svg>
			<span>{{page.glob.l10n.admin_users_delete}}</span>
		</a>
		<a href="#" class="bbs-btn bbs-modal-close" onclick="document.getElementById('delete').classList.remove('open'); document.querySelector('.bbs-drawer-backdrop').classList.remove('open'); return false;">
			{{page.glob.l10n.cancel}}
		</a>
	</div>
</div>
{% endblock %}
