{% extends 'main.twig' %}

{% block pid %}id="pauthor_detail"{%endblock%}

{% block content %}
{% include "flash_messages.twig" %}
<section class="author-detail-row">
	<header class="clearfix">
		{# Display edit menu only on first page and if user is admin #}
		{% if curpage == 0 and isadmin %}
		<div style="float: right; margin-bottom: 10px;">
			<a id="author_edit" href="#author-mdlinks-panel" class="bbs-btn bbs-btn-mini" data-role="button">
				<svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-edit" href="#bbs-icon-edit"/></svg>
				<span>{{page.glob.l10n.edit}}</span>
			</a>
		</div>
		{% endif %}

		{# Display available metadata only on first page #}
		{% if curpage == 0 %}
		<div id="author-metadata" class="author-metadata-grid">
			<div class="author-thumb-col">
				<h2>{{ author.name }}</h2>
				{% if author.thumbnail %}
				<img id="author-thumbnail-pic" src="{{page.rot}}/{{author.thumbnail.url}}" alt="{{ author.name }}" />
				{% else %}
				<img id="author-thumbnail-pic" src="{{page.rot}}/img/writer.png" alt="{{ author.name }}" />
				{% endif %}
				{% if isadmin %}
				<div style="margin-top: 8px;">
					<a href="#author-mdthumb-panel" class="bbs-btn bbs-btn-mini">
						<svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-edit" href="#bbs-icon-edit"/></svg>
						<span>{{page.glob.l10n.author_thumbnail}}</span>
					</a>
				</div>
				{% endif %}
			</div>
			<div id="author-links" class="author-info-col">
				<ul id="author-links-list" class="bbs-btn-group" style="list-style:none; padding:0; margin:0 0 10px 0;">
				{% if author.link %}
					<li class="author-link link-0">
						<a class="bbs-btn bbs-btn-mini" rel="external" target="_blank" href="{{author.link}}">
							<svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-cloud" href="#bbs-icon-cloud"/></svg>
							<span>{{page.glob.l10n.calibre_link}}</span>
						</a>
					</li>
				{% endif %}
				{% if author.links %}
					{% for link in author.links %}
					<li class="author-link link-{{link.id}}">
						<a class="bbs-btn bbs-btn-mini" rel="external" target="_blank" href="{{link.url}}">
							<svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-cloud" href="#bbs-icon-cloud"/></svg>
							<span>{{link.label}}</span>
						</a>
					</li>
					{% endfor %}
				{% endif %}
				</ul>

				{% if series != NULL %}
				<details class="bbs-collapsible" id="series" data-role="collapsible" open>
					<summary class="bbs-collapsible-header">{{page.glob.l10n.series}}</summary>
					<div class="bbs-collapsible-content bbs-btn-group">
						{% for this_series in series %}
						<a class="bbs-btn bbs-btn-mini" href="{{page.rot}}/series/{{this_series.id}}/0/">
							<svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-bullets" href="#bbs-icon-bullets"/></svg>
							<span>{{ this_series.name }}</span>
						</a>
						{% endfor %}
					</div>
				</details>
				{% endif %}

				{% if author.note %}
				<details class="bbs-collapsible" id="note" data-role="collapsible" open>
					<summary class="bbs-collapsible-header">{{page.glob.l10n.calibre_notes}}</summary>
					<div class="bbs-collapsible-content">
						<section id="author-note">
							{{author.note|raw}}
						</section>
					</div>
				</details>
				{% endif %}

				{% if author.notes %}
				<details class="bbs-collapsible" id="notes" data-role="collapsible" open>
					<summary class="bbs-collapsible-header">{{page.glob.l10n.author_notes}}</summary>
					<div class="bbs-collapsible-content">
						<section id="author-notes">
							{{author.notes|raw}}
						</section>
					</div>
				</details>
				{% endif %}
			</div>
		</div>
		{% else %}
		<h2>
			{{page.glob.l10n.booksby}} <em>{{ author.name }}</em>
		</h2> 
		{% endif %}
	</header>
	
	<section id="author-books" style="margin-top: 15px;">
		<ul class="bbs-listview" data-role="listview">
			{% for book in books %}
				{% include "title_entry.twig" %}		
			{% endfor %}	
		</ul>
	</section>
</section>
{% endblock %}

{% block rightpanel %}
<section class="bbs-panel bbs-panel-right" data-role="panel" data-display="overlay" data-position="right" id="author-mdthumb-panel" >
	<h2>{{page.glob.l10n.author_thumbnail}}</h2>
	<div id="flash"></div>
	<p class="bbs-form-help">{{page.glob.l10n.author_thumbnail_expl}}</p>
	<form id="author-pic" action="{{page.rot}}/metadata/authors/{{ author.id }}/thumbnail/" method="post" enctype="multipart/form-data">
		<input type="file" name="file" 
			accept="image/jpg,image/jpeg,image/pjpeg,image/png,image/x-png,.jpg,.png,.jpeg" 
			required style="margin-bottom: 10px;"/>
		<input type="submit" class="bbs-btn bbs-btn-primary bbs-btn-block" value="{{page.glob.l10n.upload}}" />
	</form>
	<div style="margin-top: 15px;">
		<a class="bbs-btn bbs-btn-danger bbs-btn-block" id="delete-image" href="#" data-proot="{{page.rot}}" data-author="{{ author.id }}">
			{{page.glob.l10n.delete}}
		</a>
	</div>
</section>

<section class="bbs-panel bbs-panel-right" data-role="panel" data-display="overlay" data-position="right" id="author-mdlinks-panel" >
	<h2>{{page.glob.l10n.author_links}}</h2>
	<div id="flash"></div>
	<p class="bbs-form-help">{{page.glob.l10n.author_links_expl}}</p>
	<form id="author-link-new" action="{{page.rot}}/metadata/authors/{{ author.id }}/links/">
  		<input type="text" name="link-description" id="link-description" placeholder="{{page.glob.l10n.author_links_text}}" maxlength="50" required />
  		<input type="url" name="link-url" id="link-url" placeholder="{{page.glob.l10n.author_links_url}}" maxlength="255" required />
  		<input type="submit" class="bbs-btn bbs-btn-primary bbs-btn-block" value="{{page.glob.l10n.save}}" />
	</form>
	<h3 style="margin-top: 20px;">{{page.glob.l10n.author_links}}</h3>
	<ul id="author-links-edit" class="bbs-listview" style="margin-top: 10px;">
		{% for link in author.links %}
		<li class="bbs-list-item link-{{link.id}}" style="padding: 8px 12px; display: flex; justify-content: space-between; align-items: center;">
			<a href="{{link.url}}" target="_blank" rel="external">{{link.label}}</a>
			<a href="#" data-proot="{{page.rot}}" data-author="{{author.id}}" data-link="{{link.id}}" class="bbs-btn bbs-btn-danger bbs-btn-mini author-link-delete">
				{{page.glob.l10n.delete}}
			</a>
		</li>
		{% endfor %}	
	</ul>
	<div style="margin-top: 15px;">
		<a href="{{page.rot}}/authors/{{ author.id }}/notes/" class="bbs-btn bbs-btn-block">
			<svg class="bbs-icon" aria-hidden="true"><use xlink:href="#bbs-icon-edit" href="#bbs-icon-edit"/></svg>
			<span>{{page.glob.l10n.author_notes}}</span>
		</a>
	</div>
</section>
{% endblock %}
