{% if status_ok == true %}
	<p class="bbs-flash bbs-flash-success success">{{page.glob.l10n.changes_saved}}</p>
{% else %}
	{% for error in errors %}
		{% if error == 1 %}
			<p class="bbs-flash bbs-flash-error error">{{page.glob.l10n.invalid_calibredir2}}</p>
		{% elseif error == 2 %}
			<p class="bbs-flash bbs-flash-error error">{{page.glob.l10n.invalid_password2}}</p>
		{% else %}
			<p class="bbs-flash bbs-flash-error error">{{page.glob.l10n.admin_pw_required2}}</p>
		{% endif %}
	{% endfor %}
{% endif %}
